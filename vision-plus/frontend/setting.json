{
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "smooth",
  "editor.fontFamily": "Fira Code",
  "editor.fontLigatures": true,
  "editor.fontSize": 12,
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "keyword",
        "settings": { "foreground": "#cc7832", "fontStyle": "bold" }
      },
      {
        "scope": [
          "variable.other.readwrite",
          "variable.parameter",
          "meta.definition.variable",
          "variable.other.constant",
          "variable.language",
          "entity.name.variable",
          "entity.other.attribute-name"
        ],
        "settings": { "foreground": "#a9b7c6" }
      },
      {
        "scope": "entity.name.function",
        "settings": { "foreground": "#ffc66d" }
      },
      {
        "scope": "support.function",
        "settings": { "foreground": "#9876aa" }
      },
      {
        "scope": ["entity.name.tag", "support.class.component", "entity.name.type"],
        "settings": { "foreground": "#a9b7c6" }
      },
      {
        "scope": ["meta.tag.jsx", "meta.tag.js"],
        "settings": { "foreground": "#e28964" }
      },
      {
        "scope": "string",
        "settings": { "foreground": "#6a8759" }
      },
      {
        "scope": "constant.numeric",
        "settings": { "foreground": "#6897bb" }
      },
      {
        "scope": "comment",
        "settings": { "foreground": "#808080", "fontStyle": "italic" }
      },
      {
        "scope": "punctuation.definition.tag",
        "settings": { "foreground": "#e28964" }
      }
    ]
  },
  "workbench.colorCustomizations": {
    "editor.foreground": "#a9b7c6"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "notebook.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "prettier.tabWidth": 2,
  "editor.lineHeight": 22,
  "prettier.useTabs": false,
  "prettier.trailingComma": "none",
  "prettier.semi": true,
  "prettier.singleQuote": true,
  "prettier.bracketSpacing": true,
  "prettier.printWidth": 100,
  "prettier.endOfLine": "lf",
  "prettier.jsxSingleQuote": false,
  "workbench.colorTheme": "Owlet (Charcoal)"
}
